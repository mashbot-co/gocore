# Compiled tool binaries — `go build` writes to the current working directory
# by default, so the same binary can land at the module root, inside the tool
# directory, or anywhere else `go build` is invoked from. Match by name so we
# catch every case.
gqlgen
migrate

# ...but the source directories of those tools must stay tracked. The bare
# patterns above otherwise match the directories themselves and hide every
# file inside. Re-including the directories lets the source files surface
# again; files inside that match the binary name (e.g. `tools/migrate/migrate`
# after `go build`) stay ignored.
!tools/gqlgen/
!tools/migrate/

# Test coverage outputs
cov.out
cov.html
coverage.out
coverage.html

# Module / build outputs that should never be committed.
/vendor/

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
